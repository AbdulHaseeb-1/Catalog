EXPO_PUBLIC_API_URL=http://localhost:4000

# The host Android App Links / iOS Universal Links verify against - must
# match PUBLIC_MOBILE_URL's host (no scheme, no port for production). Only
# used at build time (baked into app.config.ts's native deep-link config),
# so changing it requires a rebuild, not just a restart.
EXPO_PUBLIC_MOBILE_HOST=verify.example.com

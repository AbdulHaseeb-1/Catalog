DATABASE_URL=postgresql://verifybridge:verifybridge@localhost:5432/verifybridge?schema=public
REDIS_URL=redis://localhost:6379

API_PORT=4000
NODE_ENV=development

PUBLIC_API_URL=http://localhost:4000
PUBLIC_MOBILE_URL=http://localhost:5174

# Comma-separated list of allowed CORS origins. Add the extension's
# chrome-extension://<id> origin once you've loaded it unpacked, and any
# demo/integrated site origins.
CORS_ALLOWED_ORIGINS=http://localhost:5175

# Origins allowed to create a session while claiming a *different* origin in
# the request body - i.e. your loaded extension's chrome-extension://<id>.
# Leave empty until you've loaded the extension unpacked and know its ID.
TRUSTED_INTERMEDIARY_ORIGINS=

# "demo" is the only provider implemented out of the box. See
# src/verification/providers for how to register a real one.
VERIFICATION_PROVIDER=demo

SESSION_TTL_SECONDS=300

# Generate real random values for any non-local environment:
#   openssl rand -hex 32
TOKEN_HASH_SECRET=dev-only-token-hash-secret-change-me
WEBHOOK_SIGNING_SECRET=dev-only-webhook-secret-change-me

RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=20

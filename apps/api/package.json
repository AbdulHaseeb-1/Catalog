    "@nestjs/platform-ws": "^12.0.1",
    "@nestjs/websockets": "^12.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@verifybridge/shared": "workspace:*",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.1.0",
    "pg": "^8.23.0",
    "pino-http": "^11.0.0",

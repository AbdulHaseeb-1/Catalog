    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.10.0",

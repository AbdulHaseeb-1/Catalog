{
  "name": "verifybridge",
  "version": "0.1.0",
  "private": true,
  "description": "VerifyBridge - cross-device identity verification handoff (Chrome extension + mobile PWA + backend)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/**\" run build",
    "dev": "pnpm build:packages && pnpm --parallel --filter \"./apps/**\" run dev",
    "dev:api": "pnpm --filter @verifybridge/api run dev",
    "dev:mobile": "pnpm --filter @verifybridge/mobile run dev",
    "dev:extension": "pnpm --filter @verifybridge/extension run dev",
    "dev:demo": "pnpm --filter @verifybridge/demo-site run dev",
    "build": "pnpm build:packages && pnpm --filter \"./apps/**\" run build",
    "build:extension": "pnpm --filter @verifybridge/extension run build",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @verifybridge/api run db:migrate",
    "db:generate": "pnpm --filter @verifybridge/api run db:generate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.70.0"
  },
  "packageManager": "pnpm@10.33.0"
}

# -----------------------------------------------------------------------------
# VerifyBridge - root environment reference
#
# This file documents every environment variable used across the monorepo.
# Each app also has its own `.env.example` (apps/api, apps/mobile,
# apps/demo-site, apps/extension) that you should copy to `.env` for local
# development. Never commit real secrets.
# -----------------------------------------------------------------------------

# --- Database & cache (apps/api) --------------------------------------------
DATABASE_URL=postgresql://verifybridge:verifybridge@localhost:5432/verifybridge?schema=public
REDIS_URL=redis://localhost:6379

# --- API server (apps/api) --------------------------------------------------
API_PORT=4000
NODE_ENV=development

# Public URLs the frontends and QR codes are built from.
PUBLIC_API_URL=http://localhost:4000
PUBLIC_MOBILE_URL=http://localhost:5174

# Comma-separated list of allowed CORS origins: the mobile PWA (it calls
# the API directly from its own origin) and any demo/integrated desktop
# site. The Chrome extension does not need to be listed here - any
# chrome-extension:// origin is always allowed, since a published
# extension has one fixed ID shared by every install anyway (see main.ts).
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5175

# Origins allowed to create a session while claiming a *different* origin in
# the request body - i.e. your loaded extension's chrome-extension://<id>.
# Leave empty until you've loaded the extension unpacked and know its ID.
TRUSTED_INTERMEDIARY_ORIGINS=

# Which VerificationProvider implementation to use. "demo" is the only
# provider wired up out of the box and is for development/demo purposes only.
VERIFICATION_PROVIDER=demo

# Default lifetime of a verification session.
SESSION_TTL_SECONDS=300

# Secrets used to hash session tokens and verify provider webhook signatures.
# Generate real random values for any non-local environment, e.g.
# `openssl rand -hex 32`.
TOKEN_HASH_SECRET=dev-only-token-hash-secret-change-me
WEBHOOK_SIGNING_SECRET=dev-only-webhook-secret-change-me

# Rate limiting (requests per window, per IP) for session creation endpoints.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=20

# --- Mobile PWA (apps/mobile) -----------------------------------------------
VITE_API_URL=http://localhost:4000

# --- Demo site (apps/demo-site) ---------------------------------------------
# No environment variables needed - it only talks to the extension via
# window.postMessage, never directly to the API.

# --- Chrome extension (apps/extension) --------------------------------------
WXT_PUBLIC_API_URL=http://localhost:4000
WXT_PUBLIC_MOBILE_URL=http://localhost:5174
WXT_PUBLIC_DEMO_SITE_URL=http://localhost:5175
